# Copy to .env and set Yandex Cloud credentials before starting the worker.
YANDEX_CLOUD_API_KEY=
YANDEX_CLOUD_FOLDER=
KAFKA_TODO_TOPIC=todos-created
# Non-secret string returned as status by GET /health.
HEALTH_STATUS_ENV=ok
AUTH_USERNAME=demo
AUTH_PASSWORD=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
